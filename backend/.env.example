[TEMPLATE]
# ------------------------------------------------------------------
# Backend environment — copy to .env and fill in real values.
#   cp .env.example .env
# Never commit .env. On Vercel, set these as Project Environment Variables
# instead (Production + Preview).
# ------------------------------------------------------------------

# PostgreSQL connection (Prisma). Matches docker-compose.yml (host port 5433)
# for local development.
#
# PRODUCTION (e.g. Vercel Postgres / Neon, private managed DB):
#   - Set DATABASE_URL to the POOLED URL, with sslmode + pgbouncer flags, e.g.
#     postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require&pgbouncer=true
#   - Set DIRECT_URL to the DIRECT (non-pooled) URL, e.g.
#     postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require
#     Prisma uses it for migrations; pooled connections cannot run DDL.
DATABASE_URL=postgresql://footwear:footwear@localhost:5433/footwear
DIRECT_URL=postgresql://footwear:footwear@localhost:5433/footwear

# JWT signing secret. MUST be a strong random value (>= 32 chars) in production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=7fK9vQ2mX8pL4rT6yN3cW9zA5sD1hG7jU0kE4bR8xP6qV2nM5tY9wC3fH7aJ1

# Token lifetime (default 7d). Use a shorter value in production if desired.
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of origins allowed to call the API.
# Production example: https://suzu-bd.vercel.app
# In production this is fail-closed: only these origins (and non-browser
# requests) may call the API.
CORS_ORIGINS=http://localhost:3000

# API port (default 4000). Vercel overrides this with its own PORT.
PORT=4000

# development | production. Vercel sets NODE_ENV itself; keep this only for
# local runs.
NODE_ENV=development

# Number of trusted reverse-proxy hops in front of the API (only used when
# NODE_ENV=production). 1 = one nginx/Caddy/Vercel edge in front.
TRUST_PROXY_HOPS=1

# Vercel Blob store token (optional).
# When set, uploaded images (products + hero slides) are stored in Vercel Blob
# instead of the local filesystem — required for serverless deploys, where the
# function disk is ephemeral. Create a store in the Vercel dashboard
# (Storage -> Create -> Blob) and paste its BLOB_READ_WRITE_TOKEN here.
# Leave empty for local development (files stay in ./uploads).
#BLOB_READ_WRITE_TOKEN=
