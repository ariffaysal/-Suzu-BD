[TEMPLATE]
# ------------------------------------------------------------------
# Frontend environment — copy to .env.local and fill in real values.
#   cp .env.example .env.local
# Never commit .env.local.
#
# NOTE: NEXT_PUBLIC_* values are baked into the client bundle at BUILD TIME.
# On Vercel set them as Project Environment Variables (Production + Preview)
# and redeploy after changing them — they must point at the deployed API,
# not localhost.
# ------------------------------------------------------------------

# Base URL of the NestJS API (all /api/* calls).
# Local:  http://localhost:4000/api
# Vercel: https://<backend-project>.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Origin of the NestJS API, used to resolve uploaded image paths like
# "/uploads/xxx.png" into full URLs. Must match NEXT_PUBLIC_API_URL's origin.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
